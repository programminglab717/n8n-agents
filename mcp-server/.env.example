# ReachInbox API key (ReachInbox > Settings > API / Integrations)
REACHINBOX_API_KEY=

# Any long random string, e.g. `openssl rand -hex 32`.
# Put the same value in the n8n credential "ReachInbox MCP gateway key" (Bearer Auth).
MCP_GATEWAY_API_KEY=

# Only for the optional HTTPS profile (n8n Cloud): a DNS name pointing at this server.
MCP_DOMAIN=mcp.example.com
