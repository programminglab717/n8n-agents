{
  "name": "Hair Queen LA – Knowledge Base → Pinecone",
  "nodes": [
    {
      "parameters": {
        "content": "## Load the knowledge base into Pinecone\nRun manually whenever the knowledge base changes.\n\n**A. Google Drive folder**: put your GHL exports (table CSVs, uploaded files, FAQ doc) in one folder. Google Docs are exported as text and Sheets as CSV.\n\n**B. Website pages**: list the pages your GHL bot crawled (FAQ, services, policies, about…).\n\nTo rebuild from scratch, set *Clear Namespace* on the first Pinecone node, run, then switch it off.\nProducts are **not** indexed: the agent searches the live Shopify store instead.",
        "height": 330,
        "width": 560,
        "color": 4
      },
      "id": "09b8cf5d-baf5-5a55-9519-ba505c45d474",
      "name": "Note: Overview",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -700,
        -440
      ]
    },
    {
      "parameters": {},
      "id": "fb51e67d-75e5-5e27-8d6b-ea46cc485fdf",
      "name": "Run ingestion",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -660,
        0
      ]
    },
    {
      "parameters": {
        "resource": "fileFolder",
        "returnAll": true,
        "filter": {
          "folderId": {
            "__rl": true,
            "mode": "url",
            "value": "https://drive.google.com/drive/folders/REPLACE-WITH-FOLDER-ID"
          },
          "whatToSearch": "files"
        },
        "options": {
          "fields": [
            "id",
            "name",
            "mimeType"
          ]
        }
      },
      "id": "0ff0a286-bf22-5b9d-b611-2e9185bfbbac",
      "name": "List files in KB folder",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        -420,
        -100
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "operation": "download",
        "fileId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.id }}"
        },
        "options": {
          "googleFileConversion": {
            "conversion": {
              "docsToFormat": "text/plain",
              "sheetsToFormat": "text/csv",
              "slidesToFormat": "application/pdf"
            }
          }
        }
      },
      "id": "ee7999eb-b7fc-59e7-86cc-3555c8eb7400",
      "name": "Download file",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        -200,
        -100
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "mode": "insert",
        "pineconeIndex": {
          "__rl": true,
          "mode": "id",
          "value": "hairqueenla-kb"
        },
        "embeddingBatchSize": 100,
        "options": {
          "pineconeNamespace": "brand",
          "clearNamespace": false
        }
      },
      "id": "a3d22049-0132-5adf-881e-cc0bf2c28da6",
      "name": "Pinecone: insert files",
      "type": "@n8n/n8n-nodes-langchain.vectorStorePinecone",
      "typeVersion": 1.3,
      "position": [
        60,
        -100
      ],
      "credentials": {
        "pineconeApi": {
          "id": "",
          "name": "Pinecone account"
        }
      }
    },
    {
      "parameters": {
        "model": "text-embedding-3-small",
        "options": {}
      },
      "id": "783b13d4-5edc-5402-8c7a-6444ab3f01de",
      "name": "Embeddings (files)",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1.2,
      "position": [
        0,
        140
      ],
      "credentials": {
        "openAiApi": {
          "id": "",
          "name": "OpenAI account (embeddings)"
        }
      }
    },
    {
      "parameters": {
        "dataType": "binary",
        "binaryMode": "allInputData",
        "loader": "auto",
        "textSplittingMode": "custom",
        "options": {
          "metadata": {
            "metadataValues": [
              {
                "name": "source",
                "value": "={{ $('List files in KB folder').item.json.name }}"
              },
              {
                "name": "kind",
                "value": "file"
              }
            ]
          }
        }
      },
      "id": "1907dbf8-ea89-56b4-b8f7-bdd3bcfc365a",
      "name": "Loader (files)",
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1.1,
      "position": [
        160,
        140
      ]
    },
    {
      "parameters": {
        "chunkSize": 1000,
        "chunkOverlap": 150,
        "options": {}
      },
      "id": "d2a23891-6ed5-5447-b37a-582da7480060",
      "name": "Splitter (files)",
      "type": "@n8n/n8n-nodes-langchain.textSplitterRecursiveCharacterTextSplitter",
      "typeVersion": 1,
      "position": [
        160,
        320
      ]
    },
    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "{\n  \"urls\": [\n    \"https://hairqueenla.com/pages/about-us\",\n    \"https://hairqueenla.com/pages/faq\",\n    \"https://hairqueenla.com/pages/contact\",\n    \"https://hairqueenla.com/policies/shipping-policy\",\n    \"https://hairqueenla.com/policies/refund-policy\"\n  ]\n}",
        "options": {}
      },
      "id": "57976bf2-d574-530e-aa50-e2212ee64f04",
      "name": "Website pages to index",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -420,
        480
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "urls",
        "options": {
          "destinationFieldName": "url"
        }
      },
      "id": "1f3afe50-8243-5283-976f-3bfa0f931cbb",
      "name": "One item per URL",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        -200,
        480
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.url }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text",
              "outputPropertyName": "html"
            }
          }
        }
      },
      "id": "af346dcc-dbb0-54d8-b71e-d57644be0f8e",
      "name": "Fetch page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        20,
        480
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "html": "={{ $json.html }}",
        "destinationKey": "text",
        "options": {
          "ignore": "script,style,nav,header,footer,form,svg,noscript"
        }
      },
      "id": "9d4b8fd4-9bb7-5c91-ba49-36ab3870300c",
      "name": "HTML → Markdown",
      "type": "n8n-nodes-base.markdown",
      "typeVersion": 1,
      "position": [
        240,
        480
      ]
    },
    {
      "parameters": {
        "mode": "insert",
        "pineconeIndex": {
          "__rl": true,
          "mode": "id",
          "value": "hairqueenla-kb"
        },
        "embeddingBatchSize": 100,
        "options": {
          "pineconeNamespace": "brand"
        }
      },
      "id": "97089576-37e8-5eea-9fb4-4b0d9091ea59",
      "name": "Pinecone: insert pages",
      "type": "@n8n/n8n-nodes-langchain.vectorStorePinecone",
      "typeVersion": 1.3,
      "position": [
        480,
        480
      ],
      "credentials": {
        "pineconeApi": {
          "id": "",
          "name": "Pinecone account"
        }
      }
    },
    {
      "parameters": {
        "model": "text-embedding-3-small",
        "options": {}
      },
      "id": "b263ee62-2415-5367-b14c-2a66af4903a8",
      "name": "Embeddings (pages)",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1.2,
      "position": [
        420,
        720
      ],
      "credentials": {
        "openAiApi": {
          "id": "",
          "name": "OpenAI account (embeddings)"
        }
      }
    },
    {
      "parameters": {
        "dataType": "json",
        "jsonMode": "expressionData",
        "jsonData": "={{ $json.text }}",
        "textSplittingMode": "custom",
        "options": {
          "metadata": {
            "metadataValues": [
              {
                "name": "source",
                "value": "={{ $('One item per URL').item.json.url }}"
              },
              {
                "name": "kind",
                "value": "web_page"
              }
            ]
          }
        }
      },
      "id": "ec979362-1829-5fa8-ade7-5c6e12524334",
      "name": "Loader (pages)",
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1.1,
      "position": [
        580,
        720
      ]
    },
    {
      "parameters": {
        "chunkSize": 1000,
        "chunkOverlap": 150,
        "options": {}
      },
      "id": "b8caa94e-4a72-5b6f-9364-f27353ab7995",
      "name": "Splitter (pages)",
      "type": "@n8n/n8n-nodes-langchain.textSplitterRecursiveCharacterTextSplitter",
      "typeVersion": 1,
      "position": [
        580,
        900
      ]
    }
  ],
